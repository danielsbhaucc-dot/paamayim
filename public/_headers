# Cloudflare Pages — כותרות אבטחה לאתר ה-web ולקובצי התוכן
# CSP מאפשר פונטים מקומיים, תוכן מאותו דומיין, ו-Sefaria (אם ייקרא בעתיד).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://www.sefaria.org https://*.sefaria.org; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

/content/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/assets/*
  Cache-Control: public, max-age=31536000, immutable
