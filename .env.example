# משתני בנייה של האפליקציה (העתיקו ל-.env לפי הצורך).
# שימו לב: כל משתנה שמתחיל ב-EXPO_PUBLIC_ נארז לתוך האפליקציה ונגלה לכל משתמש —
# לעולם לא לשים כאן מפתחות API או סיסמאות. מפתחות ה-AI וה-GitHub יושבים רק ב-admin/.env (בצד השרת).

# כתובת האתר שממנו האפליקציה מורידה תוכן מעודכן (<base>/content/index.json)
EXPO_PUBLIC_CONTENT_BASE_URL=https://paamayim.pages.dev
