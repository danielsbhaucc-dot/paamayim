{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
        "./packages/@core/*/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "module": "esnext"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "admin",
    "dist",
    ".cache",
    "packages/@core/*/tests",
    "packages/@core/*/demo"
  ]
}
