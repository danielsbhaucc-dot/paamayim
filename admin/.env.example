# ─────────────────────────────────────────────────────────────
#  נהורא · ניהול תוכן — הגדרות שרת (admin/.env)
#  הקובץ admin/.env לעולם לא נכנס ל-git (.gitignore). כאן — רק דוגמה.
#  הדרך הקלה: npm run admin  → יוצר את admin/.env לבד ושואל סיסמה.
# ─────────────────────────────────────────────────────────────

# ── התחברות ──
# גיבוב הסיסמה (לא הסיסמה עצמה!). ליצירה: npm --prefix admin run hash-password
ADMIN_PASSWORD_HASH=
# מפתח חתימה לעוגיות (לפחות 32 תווים אקראיים). npm run admin יוצר אותו לבד.
SESSION_SECRET=
# (אופציונלי) טוקן לגישה מכונה-למכונה ל-JSON API (דשבורד עתידי). לפחות 32 תווים.
ADMIN_API_TOKEN=

# ── שרת ──
# 127.0.0.1 = רק מהמחשב הזה (מומלץ). באירוח: 0.0.0.0
HOST=127.0.0.1
PORT=8787
# באירוח מאחורי HTTPS/פרוקסי (Render, Fly, Cloudflare):
# NODE_ENV=production
# COOKIE_SECURE=1
# TRUST_PROXY=1
# ALLOWED_ORIGINS=https://admin.example.com

# ── אחסון ──
# local = קבצים בתיקיית הפרויקט במחשב (ברירת מחדל)
# github = כל שמירה היא commit לריפו דרך GitHub API (לאירוח)
STORAGE=local
# GITHUB_TOKEN=github_pat_...   ← Fine-grained token, רק לריפו הזה, הרשאה Contents: Read and write
# GITHUB_REPO=danielsbhaucc-dot/paamayim
# GITHUB_BRANCH=master              ← ענף הייצור (Cloudflare בונה ממנו)
# GITHUB_DRAFT_BRANCH=content-drafts ← טיוטות נשמרות כאן; «פרסם הכול» מעביר ל-master

# ── AI (המפתחות נשארים רק בשרת, לא נשלחים לדפדפן) ──
# DeepSeek ישיר: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# deepseek או openrouter
AI_DEFAULT_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# תקרת עלות לעבודה מרוכזת אחת (דולר)
AI_MAX_JOB_USD=5
# 1 = מצב דמו בלי מפתחות ובלי עלות (טקסט דמו מסומן)
AI_MOCK=0
